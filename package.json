{
  "name": "cuddle-code",
  "displayName": "Cuddle Code",
  "description": "VS Code extension that reacts to coding activity with supportive voice coaching using ElevenLabs.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cuddleCode.toggleEnabled",
    "onCommand:cuddleCode.toggleMode",
    "onCommand:cuddleCode.testVoiceLine",
    "onCommand:cuddleCode.testVoiceLineForceFetch",
    "onCommand:cuddleCode.showTriggerDebug",
    "onCommand:cuddleCode.preGenerateVoiceCache",
    "onCommand:cuddleCode.clearVoiceCache",
    "onCommand:cuddleCode.showCacheStats",
    "onCommand:cuddleCode.showTriggerHealth",
    "onCommand:cuddleCode.simulateTrigger"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cuddleCode.toggleEnabled",
        "title": "Cuddle Code: Toggle Enabled"
      },
      {
        "command": "cuddleCode.toggleMode",
        "title": "Cuddle Code: Toggle Mock/Audio"
      },
      {
        "command": "cuddleCode.testVoiceLine",
        "title": "Cuddle Code: Test Voice Line"
      },
      {
        "command": "cuddleCode.testVoiceLineForceFetch",
        "title": "Cuddle Code: Test Voice Line (Force Fetch)"
      },
      {
        "command": "cuddleCode.showTriggerDebug",
        "title": "Cuddle Code: Show Trigger Debug"
      },
      {
        "command": "cuddleCode.preGenerateVoiceCache",
        "title": "Cuddle Code: Pre-Generate Voice Cache"
      },
      {
        "command": "cuddleCode.clearVoiceCache",
        "title": "Cuddle Code: Clear Voice Cache"
      },
      {
        "command": "cuddleCode.showCacheStats",
        "title": "Cuddle Code: Show Cache Stats"
      },
      {
        "command": "cuddleCode.showTriggerHealth",
        "title": "Cuddle Code: Show Trigger Health"
      },
      {
        "command": "cuddleCode.simulateTrigger",
        "title": "Cuddle Code: Simulate Trigger"
      }
    ],
    "configuration": {
      "title": "Cuddle Code",
      "properties": {
        "cuddleCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Cuddle Code reactions."
        },
        "cuddleCode.mode": {
          "type": "string",
          "enum": [
            "mock",
            "audio"
          ],
          "default": "mock",
          "description": "mock logs lines only; audio calls ElevenLabs and plays sound."
        },
        "cuddleCode.apiKey": {
          "type": "string",
          "default": "",
          "description": "ElevenLabs API key (used in audio mode)."
        },
        "cuddleCode.longLineThreshold": {
          "type": "number",
          "default": 100,
          "minimum": 40,
          "description": "Line length threshold that triggers long-line praise."
        },
        "cuddleCode.minSecondsBetweenMessages": {
          "type": "number",
          "default": 45,
          "minimum": 1,
          "description": "Global anti-spam gap between messages."
        },
        "cuddleCode.longLineCooldownSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 1,
          "description": "Cooldown for long-line praise trigger."
        },
        "cuddleCode.idleAfterSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 3,
          "description": "Seconds of no typing before idle nudge trigger."
        },
        "cuddleCode.idleCooldownSeconds": {
          "type": "number",
          "default": 240,
          "minimum": 1,
          "description": "Cooldown for idle nudge trigger."
        },
        "cuddleCode.sustainedWindowSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "description": "Window for sustained typing detection."
        },
        "cuddleCode.sustainedEditsThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 3,
          "description": "Edits required inside sustained window."
        },
        "cuddleCode.sustainedCooldownSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "Cooldown for sustained typing trigger."
        },
        "cuddleCode.burstWindowSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Window for burst typing detection."
        },
        "cuddleCode.burstEditsThreshold": {
          "type": "number",
          "default": 18,
          "minimum": 2,
          "description": "Edits required inside burst window."
        },
        "cuddleCode.burstCooldownSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "description": "Cooldown for burst typing trigger."
        },
        "cuddleCode.debugLogs": {
          "type": "boolean",
          "default": true,
          "description": "Show trigger and playback debug logs in output channel."
        },
        "cuddleCode.usePreGeneratedAudio": {
          "type": "boolean",
          "default": true,
          "description": "Use cached pre-generated audio clips first in audio mode."
        },
        "cuddleCode.preGenerateOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Generate all script lines into cache when extension starts (audio mode only)."
        },
        "cuddleCode.voicePersona": {
          "type": "string",
          "enum": [
            "female",
            "male",
            "mixed"
          ],
          "default": "female",
          "description": "Voice persona routing: female-only, male-only, or mixed trigger-based selection."
        },
        "cuddleCode.pacingMode": {
          "type": "string",
          "enum": [
            "normal",
            "demo",
            "debug"
          ],
          "default": "normal",
          "description": "Cadence profile for scheduler timing multipliers (normal, demo, debug)."
        },
        "cuddleCode.llmApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for dynamic Sandy mention responses."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npx tsc -p tsconfig.test.json && node --test .test-dist/test/**/*.test.js",
    "package:vsix": "npx @vscode/vsce package -o cuddle-code.vsix",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.1",
    "@types/node": "^20.17.43",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  }
}
