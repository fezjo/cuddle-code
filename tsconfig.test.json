{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2021"
    ],
    "strict": true,
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/content/scriptBank.ts",
    "src/telemetry/scheduler.ts",
    "src/telemetry/detectors.ts",
    "src/types.ts",
    "test/**/*.ts"
  ]
}
